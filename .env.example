# Copy to .env and fill in.

# Your Anthropic API key (required). Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Vision model used to read the filament package. Default is fine.
ANTHROPIC_MODEL=claude-opus-4-8

# Base URL the backend uses to reach Spoolman (no trailing slash needed).
# In Docker Compose with the bundled Spoolman this is http://spoolman:8000.
SPOOLMAN_URL=http://localhost:7912

# Optional: browser-facing Spoolman URL, used only for clickable "open spool"
# links. Set this when SPOOLMAN_URL is an internal address the browser can't
# reach (e.g. the Docker service name). Falls back to SPOOLMAN_URL if empty.
SPOOLMAN_PUBLIC_URL=
